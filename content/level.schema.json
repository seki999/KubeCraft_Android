{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "chapterId",
    "title",
    "description",
    "prerequisites",
    "knowledgeIds",
    "story",
    "dialogues",
    "simulation",
    "allowedActions",
    "objectives",
    "hints",
    "review",
    "score",
    "rewards",
    "implemented",
    "knowledgeQuestion",
    "knowledgeAnswer"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "story": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "chapterId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "implemented": {
      "type": "boolean"
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "knowledgeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "enum": [
          "AddNode",
          "SetNodeReady",
          "CreatePod",
          "Deploy",
          "Scale",
          "DeletePod",
          "UpdateImage",
          "Rollback",
          "Expose",
          "SetLoad",
          "Autoscale",
          "Advanced",
          "Tick"
        ]
      },
      "uniqueItems": true
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dialogues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "enum": [
              "Maya",
              "Leo",
              "K8-Bot"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "speaker",
          "text"
        ]
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "nodes",
              "readyPods",
              "replicas",
              "endpoints",
              "image",
              "event",
              "planned",
              "namespace",
              "serviceType",
              "route",
              "configMounted",
              "secretMounted",
              "mounted",
              "boundClaim",
              "persisted",
              "stateful",
              "requests",
              "priority",
              "selected",
              "hpa",
              "load",
              "probe",
              "release",
              "plan",
              "region",
              "oke",
              "pool"
            ]
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target",
          "value",
          "text"
        ]
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion": {
          "type": "integer",
          "minimum": 0
        },
        "resource": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "integer",
          "minimum": 0
        },
        "knowledge": {
          "type": "integer",
          "minimum": 0
        },
        "noHints": {
          "type": "integer",
          "minimum": 0
        },
        "idealActions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "completion",
        "resource",
        "operations",
        "knowledge",
        "noHints",
        "idealActions"
      ]
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "achievement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "xp",
        "achievement"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer"
        },
        "initialState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": {
              "type": "integer"
            },
            "tick": {
              "type": "integer"
            },
            "serial": {
              "type": "integer"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "cpu": {
                    "type": "integer"
                  },
                  "memory": {
                    "type": "integer"
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "labels": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "pods": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string"
                  },
                  "labels": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "cpu": {
                    "type": "integer"
                  },
                  "memory": {
                    "type": "integer"
                  },
                  "nodeSelector": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "node": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "phase": {
                    "type": "string"
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "born": {
                    "type": "integer"
                  },
                  "logs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "config": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "secret": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "claim": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "limitMemory": {
                    "type": "integer"
                  },
                  "usageMemory": {
                    "type": "integer"
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "restarts": {
                    "type": "integer"
                  },
                  "healthy": {
                    "type": "boolean"
                  },
                  "readinessProbe": {
                    "type": "boolean"
                  },
                  "livenessProbe": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "deployments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "replicas": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 30
                  },
                  "image": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cpu": {
                    "type": "integer"
                  },
                  "memory": {
                    "type": "integer"
                  },
                  "nodeSelector": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "selector": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "endpoints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "selector"
                ]
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "configMaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "secrets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "volumes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "capacity": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "capacity"
                ]
              }
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "capacity": {
                    "type": "integer"
                  },
                  "volume": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "capacity"
                ]
              }
            },
            "hpas": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "deployment": {
                    "type": "string"
                  },
                  "min": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  },
                  "target": {
                    "type": "integer"
                  }
                },
                "required": [
                  "deployment"
                ]
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuPercent": {
                  "type": "integer"
                }
              },
              "required": []
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tick": {
                    "type": "integer"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "tick",
                  "reason",
                  "message"
                ]
              }
            },
            "replicaSets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "deployment": {
                    "type": "string"
                  },
                  "revision": {
                    "type": "integer"
                  },
                  "desired": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "deployment",
                  "revision",
                  "desired"
                ]
              }
            },
            "advanced": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ingresses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "host": {
                        "type": "string"
                      },
                      "service": {
                        "type": "string"
                      },
                      "namespace": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "host",
                      "service"
                    ]
                  }
                },
                "statefulSets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "replicas": {
                        "type": "integer"
                      },
                      "image": {
                        "type": "string"
                      },
                      "claim": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "replicas",
                      "claim"
                    ]
                  }
                },
                "releases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "replicas": {
                        "type": "integer"
                      },
                      "revision": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "name",
                      "replicas"
                    ]
                  }
                },
                "plan": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "region": {
                          "type": "string"
                        },
                        "workers": {
                          "type": "integer"
                        },
                        "applied": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "region",
                        "workers"
                      ]
                    }
                  ]
                },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "oke": {
                  "type": "boolean"
                },
                "region": {
                  "type": "string"
                },
                "nodePool": {
                  "type": "integer"
                }
              },
              "required": []
            }
          },
          "required": []
        }
      },
      "required": [
        "seed",
        "initialState"
      ]
    },
    "knowledgeQuestion": {
      "type": "string",
      "minLength": 1
    },
    "knowledgeAnswer": {
      "type": "string",
      "minLength": 1
    }
  }
}